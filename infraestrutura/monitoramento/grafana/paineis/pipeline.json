{
  "uid": "pipeline-pipeline",
  "title": "Pipeline — execuções e disponibilidade",
  "schemaVersion": 39,
  "version": 3,
  "tags": [
    "local",
    "pipeline-etl"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Execuções persistidas por situação",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_local"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pipeline_execucoes",
          "legendFormat": "{{rota}} {{metodo}} {{situacao}} {{serie}} {{alertname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
