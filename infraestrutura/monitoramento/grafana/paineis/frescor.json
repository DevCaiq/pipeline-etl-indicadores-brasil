{
  "uid": "pipeline-frescor",
  "title": "Frescor e cobertura — BCB e IBGE",
  "schemaVersion": 39,
  "version": 2,
  "tags": [
    "local",
    "pipeline-etl"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Defasagem: 1 atrasada, 0 em dia, -1 desconhecida",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_local"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pipeline_serie_defasada",
          "legendFormat": "{{rota}} {{metodo}} {{situacao}} {{serie}} {{alertname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Alertas locais ativos",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus_local"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\",ambiente=\"local\"}",
          "legendFormat": "{{rota}} {{metodo}} {{situacao}} {{serie}} {{alertname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
