# Copie para .env somente se desejar alterar os padrões locais.
# Compose usa .env.banco separado. URLs abaixo são opcionais para acesso pelo host.
AMBIENTE=desenvolvimento
NIVEL_REGISTROS=INFO
CAMINHO_BRONZE=dados/bronze
SERIES_BCB=432,433,1

# Não ativar placeholders. Use senha local codificada corretamente na URL.
# URL_BANCO_API=postgresql+psycopg://api_leitura:SENHA_CODIFICADA@127.0.0.1:55432/etl
# URL_BANCO_PROCESSAMENTO=postgresql+psycopg://processamento:SENHA_CODIFICADA@127.0.0.1:55432/etl
# URL_BANCO_MIGRACOES=postgresql+psycopg://migracoes:SENHA_CODIFICADA@127.0.0.1:55432/etl

# URL_BANCO_PUBLICADOR=postgresql+psycopg://publicador:SENHA_CODIFICADA@127.0.0.1:55432/etl

# API: scripts/preparar_api.py cria .env.api exclusivo usando api_leitura e um segredo novo.
# SEGREDO_CURSOR deve ter pelo menos32bytes; não ativar um exemplo como senha real.
# LIMITE_REQUISICOES_MINUTO=100

# Cache opcional: mantém PostgreSQL como autoridade de publicação.
# CACHE_HABILITADO=false
# URL_REDIS=redis://127.0.0.1:6379/0
